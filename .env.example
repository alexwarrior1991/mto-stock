# Todo lo que la aplicacion lee del entorno esta en este fichero. Lo que va comentado tiene un valor
# por defecto en application*.yaml que sirve tal cual: se lista para que se sepa que existe, no
# porque haya que rellenarlo. Las variables del perfil 'test' (TEST_DATABASE_*) no estan aqui a
# proposito: las usa la suite, no el contenedor.

# Spring application
SPRING_PROFILES_ACTIVE=prod
# Perfil que se aplica cuando no hay ninguno activo. Con SPRING_PROFILES_ACTIVE puesto no se usa.
# SPRING_PROFILES_DEFAULT=dev
SERVER_PORT=8080
APP_PORT=8080
APP_IMAGE_TAG=latest
APP_VERSION=0.0.1-SNAPSHOT

# Application database connection.
# The database itself lives in mto-platform, published on the host. From inside this container it
# is reached through host.docker.internal; from the IDE, through localhost.
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/mto_stock
DATABASE_USERNAME=mto_stock_user
DATABASE_PASSWORD=mto_stock_password

# Keycloak / OAuth2 resource server
# La API valida los JWT que emite Keycloak; no emite tokens ni guarda usuarios, asi que aqui no hay
# ningun secreto de firma que configurar.
KEYCLOAK_ISSUER_URI=http://auth.mto.local:8082/realms/mto
KEYCLOAK_CLIENT_ID=mto-stock-api
KEYCLOAK_AUDIENCE=mto-stock-api
KEYCLOAK_AUDIENCE_VALIDATION_ENABLED=true

# Keycloak runs in mto-platform. This service only validates the tokens it issues; the client and
# the warehouse roles are contributed by keycloak/mto-stock-partial-import.json, applied by
# mto-platform/keycloak/apply-partials.sh.
# Publicar /swagger-ui y /v3/api-docs sin token. Cerrado en produccion.
APP_SECURITY_EXPOSE_API_DOCS=false
APP_CORS_ALLOWED_ORIGIN=http://localhost:4200
# Segundos que el navegador puede cachear la respuesta al preflight.
# APP_CORS_MAX_AGE=3600

# RabbitMQ / master data events from mto-configuration.
# THE SAME broker mto-configuration publishes to, the one in mto-platform. When each repository
# brought up its own, the publisher wrote to one and this consumer listened on another: nothing
# arrived and nothing failed. Do not point this anywhere else.
SPRING_RABBITMQ_HOST=host.docker.internal
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=mto
SPRING_RABBITMQ_PASSWORD=mto
SPRING_RABBITMQ_VIRTUAL_HOST=/

# Declaracion de la topologia y consumidor. Con APP_RABBITMQ_ENABLED=false la aplicacion arranca
# sin broker; con el consumidor apagado la cola se declara igual y va acumulando eventos.
APP_RABBITMQ_ENABLED=true
APP_RABBITMQ_MASTER_DATA_LISTENER_ENABLED=true
# Nombres del canal. Los valores por defecto son el contrato de mto-configuration y no hace falta
# tocarlos salvo que el broker sea compartido con otra instalacion.
# APP_RABBITMQ_MASTER_DATA_EXCHANGE=mto.master-data.exchange
# APP_RABBITMQ_MASTER_DATA_QUEUE=mto.stock.master-data.queue
# APP_RABBITMQ_MASTER_DATA_ROUTING_KEY=mto.master-data.#
# Cola de mensajes muertos, propia de este servicio. Aqui acaba lo que no se pudo procesar: un
# mensaje sin 'data', sin entityName o sin operacion, uno con la firma mal, y lo que agoto los
# reintentos. Es donde se mira cuando algo no llego.
# APP_RABBITMQ_MASTER_DATA_DEAD_LETTER_EXCHANGE=mto.stock.master-data.queue.dlx
# APP_RABBITMQ_MASTER_DATA_DEAD_LETTER_QUEUE=mto.stock.master-data.queue.dlq
# APP_RABBITMQ_MASTER_DATA_DEAD_LETTER_ROUTING_KEY=mto.stock.master-data.queue.dlq

# Consumo. La concurrencia por defecto es 1: el inbox hace idempotente cada mensaje, pero subirla
# adelanta el momento en que dos entregas del mismo agregado se solapan, y ahi lo que ordena es la
# marca de agua de secuencia, no la cola. max-retries agota los reintentos con espera creciente
# antes de mandar el mensaje a la DLQ.
# SPRING_RABBITMQ_LISTENER_CONCURRENCY=1
# SPRING_RABBITMQ_LISTENER_MAX_CONCURRENCY=5
# SPRING_RABBITMQ_LISTENER_PREFETCH=10
# SPRING_RABBITMQ_LISTENER_MAX_RETRIES=3

# Firma de los mensajes. EL MISMO VALOR que app.messaging.signature.secret en mto-configuration:
# con secreto la firma es HMAC-SHA256 y protege de manipulacion, sin el es un SHA-256 simple que solo
# detecta corrupcion. Vacio por defecto porque repartir un secreto es una decision de explotacion.
MESSAGING_SIGNATURE_SECRET=
# DISABLED | OPTIONAL | REQUIRED. Pasar a REQUIRED cuando los dos servicios compartan el secreto:
# antes de eso, REQUIRED manda a la DLQ todos los mensajes validos.
MESSAGING_SIGNATURE_MODE=OPTIONAL

# Redis / master data cache. The server lives in mto-platform; this is only the client side.
SPRING_DATA_REDIS_HOST=host.docker.internal
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=mto_redis_password
SPRING_DATA_REDIS_DATABASE=0
# Timeouts cortos a proposito: la cache es un atajo, y esperar por ella mas de lo que tarda la
# consulta a la base de datos que evita seria peor que no tenerla.
# SPRING_DATA_REDIS_TIMEOUT=500ms
# SPRING_DATA_REDIS_CONNECT_TIMEOUT=500ms

# Con APP_CACHE_ENABLED=false la aplicacion arranca sin Redis y lo sirve todo desde la base de
# datos, exactamente igual que antes de que existiera este bloque: no hay ningun dato que viva
# solo en la cache. Se cachean unicamente las lecturas por id del catalogo -material, almacen,
# proveedor, conjunto y proyecto-; nunca el stock.
APP_CACHE_ENABLED=true
APP_CACHE_DEFAULT_TTL=30m
# Prefijo de las claves. La primera parte separa este servicio de mto-configuration, que en local
# puede compartir el mismo Redis. La 'v1' es la version del FORMATO: SUBELA al cambiar la forma de
# un DTO de respuesta cacheado. Anadir un campo es el caso peligroso -la entrada vieja se
# deserializa con null en el campo nuevo y se sirve asi hasta que expire el TTL-; subir la version
# deja huerfanas las entradas viejas en vez de tener que vaciar Redis a mano.
APP_CACHE_KEY_PREFIX=mto-stock:v1:

# Flyway migrations
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# Actuator and observability
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_HEALTH_RABBIT_ENABLED=false
# Fuera del health por el mismo motivo: un Redis caido no deja al servicio incapaz de atender
# peticiones, solo mas lento, y marcarlo DOWN lo sacaria del balanceador sin necesidad.
MANAGEMENT_HEALTH_REDIS_ENABLED=false
SPRINGDOC_SHOW_ACTUATOR=false

# Logging and JVM
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_SQL=WARN
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseContainerSupport
# Volcado del SQL de Hibernate. Solo lo lee el perfil 'dev'.
# JPA_SHOW_SQL=false
# JPA_FORMAT_SQL=true
# Apagado ordenado, solo en el perfil 'prod': lo que espera es a que terminen las peticiones en
# curso, incluido el mensaje que el consumidor tenga a medias.
# SHUTDOWN_TIMEOUT=30s

# --- Trazado distribuido -----------------------------------------------------------------------
MTO_TRACING_ENABLED=true
# 0.1 = se muestrea el 10%. Un span no muestreado sigue propagando su traceparent (flag 00), asi que
# muestrear poco no rompe la cadena entre servicios.
MTO_TRACING_SAMPLING_PROBABILITY=0.1
# El colector vive en mto-platform y se alcanza por el host, igual que Keycloak. Fuera de compose
# (mvnw spring-boot:run) el nombre otel.mto.local no resuelve: usese localhost.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel.mto.local:4318/v1/traces
# Continua la traza que llega en las cabeceras del mensaje de RabbitMQ.
SPRING_RABBITMQ_LISTENER_OBSERVATION_ENABLED=true
