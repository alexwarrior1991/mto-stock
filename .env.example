# Spring application
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_PORT=8080
APP_IMAGE_TAG=latest
APP_VERSION=0.0.1-SNAPSHOT

# PostgreSQL container
POSTGRES_DB=mto_stock
POSTGRES_USER=mto_stock_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Application database connection
DATABASE_URL=jdbc:postgresql://postgres:5432/mto_stock
DATABASE_USERNAME=mto_stock_user
DATABASE_PASSWORD=change-me

# Keycloak / OAuth2 resource server
# La API valida los JWT que emite Keycloak; no emite tokens ni guarda usuarios, asi que aqui no hay
# ningun secreto de firma que configurar.
KEYCLOAK_ISSUER_URI=http://auth.mto.local:8082/realms/mto
KEYCLOAK_CLIENT_ID=mto-stock-api
KEYCLOAK_AUDIENCE=mto-stock-api
KEYCLOAK_AUDIENCE_VALIDATION_ENABLED=true

# Contenedor de Keycloak del stack local. Importa keycloak/mto-realm-local.json al arrancar.
# Si ya tienes en marcha el Keycloak de mto-configuration, comenta el servicio en
# docker-compose.yml en lugar de levantar un segundo servidor: es el mismo realm y el mismo emisor.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8082
KEYCLOAK_MANAGEMENT_PORT=9000
# Publicar /swagger-ui y /v3/api-docs sin token. Cerrado en produccion.
APP_SECURITY_EXPOSE_API_DOCS=false
APP_CORS_ALLOWED_ORIGIN=http://localhost:4200

# RabbitMQ / eventos de datos maestros de mto-configuration
# El contenedor local y la aplicacion usan las mismas credenciales: RABBITMQ_DEFAULT_* crean el
# usuario del broker y SPRING_RABBITMQ_* son las que usa la aplicacion para conectarse.
RABBITMQ_DEFAULT_USER=mto_stock
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=mto_stock
SPRING_RABBITMQ_PASSWORD=change-me
SPRING_RABBITMQ_VIRTUAL_HOST=/

# Declaracion de la topologia y consumidor. Con APP_RABBITMQ_ENABLED=false la aplicacion arranca
# sin broker; con el consumidor apagado la cola se declara igual y va acumulando eventos.
APP_RABBITMQ_ENABLED=true
APP_RABBITMQ_MASTER_DATA_LISTENER_ENABLED=true
# Nombres del canal. Los valores por defecto son el contrato de mto-configuration y no hace falta
# tocarlos salvo que el broker sea compartido con otra instalacion.
# APP_RABBITMQ_MASTER_DATA_EXCHANGE=mto.master-data.exchange
# APP_RABBITMQ_MASTER_DATA_QUEUE=mto.stock.master-data.queue
# APP_RABBITMQ_MASTER_DATA_ROUTING_KEY=mto.master-data.#

# Firma de los mensajes. EL MISMO VALOR que app.messaging.signature.secret en mto-configuration:
# con secreto la firma es HMAC-SHA256 y protege de manipulacion, sin el es un SHA-256 simple que solo
# detecta corrupcion. Vacio por defecto porque repartir un secreto es una decision de explotacion.
MESSAGING_SIGNATURE_SECRET=
# DISABLED | OPTIONAL | REQUIRED. Pasar a REQUIRED cuando los dos servicios compartan el secreto:
# antes de eso, REQUIRED manda a la DLQ todos los mensajes validos.
MESSAGING_SIGNATURE_MODE=OPTIONAL

# Redis / cache de datos maestros
# Como en RabbitMQ, el contenedor y la aplicacion comparten la misma credencial: REDIS_PASSWORD la
# fija en el servidor (--requirepass) y SPRING_DATA_REDIS_PASSWORD es la que usa la aplicacion.
REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=change-me
SPRING_DATA_REDIS_DATABASE=0

# Con APP_CACHE_ENABLED=false la aplicacion arranca sin Redis y lo sirve todo desde la base de
# datos, exactamente igual que antes de que existiera este bloque: no hay ningun dato que viva
# solo en la cache. Se cachean unicamente las lecturas por id del catalogo -material, almacen,
# proveedor, conjunto y proyecto-; nunca el stock.
APP_CACHE_ENABLED=true
APP_CACHE_DEFAULT_TTL=30m
# Prefijo de las claves. La primera parte separa este servicio de mto-configuration, que en local
# puede compartir el mismo Redis. La 'v1' es la version del FORMATO: SUBELA al cambiar la forma de
# un DTO de respuesta cacheado. Anadir un campo es el caso peligroso -la entrada vieja se
# deserializa con null en el campo nuevo y se sirve asi hasta que expire el TTL-; subir la version
# deja huerfanas las entradas viejas en vez de tener que vaciar Redis a mano.
APP_CACHE_KEY_PREFIX=mto-stock:v1:

# Flyway migrations
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# Actuator and observability
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_HEALTH_RABBIT_ENABLED=false
# Fuera del health por el mismo motivo: un Redis caido no deja al servicio incapaz de atender
# peticiones, solo mas lento, y marcarlo DOWN lo sacaria del balanceador sin necesidad.
MANAGEMENT_HEALTH_REDIS_ENABLED=false
SPRINGDOC_SHOW_ACTUATOR=false

# Logging and JVM
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_SQL=WARN
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseContainerSupport