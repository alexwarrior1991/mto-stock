{
  "realm": "mto",
  "enabled": true,
  "displayName": "MTO (local)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "sslRequired": "none",
  "roles": {
    "client": {
      "mto-stock-api": [
        {
          "name": "stock-read",
          "description": "Consulta del catalogo, del stock derivado, del historico de movimientos y de las reservas"
        },
        {
          "name": "stock-write",
          "description": "Alta y modificacion del catalogo y operaciones ordinarias de almacen"
        },
        {
          "name": "stock-delete",
          "description": "Cancelacion de reservas"
        },
        {
          "name": "stock-adjust",
          "description": "Ajustes de inventario. Se pide ADEMAS de stock-write"
        },
        {
          "name": "ops-metrics",
          "description": "Lectura de los endpoints de Actuator de mto-stock"
        },
        {
          "name": "ops-write",
          "description": "Operaciones de Actuator de mto-stock que modifican estado"
        }
      ]
    },
    "realm": [
      {
        "name": "mto-warehouse-viewer",
        "description": "Consulta de almacen",
        "composite": true,
        "composites": {
          "client": {
            "mto-stock-api": [
              "stock-read"
            ]
          }
        }
      },
      {
        "name": "mto-warehouse-operator",
        "description": "Trabajo diario de almacen",
        "composite": true,
        "composites": {
          "client": {
            "mto-stock-api": [
              "stock-read",
              "stock-write"
            ]
          }
        }
      },
      {
        "name": "mto-warehouse-admin",
        "description": "Responsables del almacen: cancelan reservas y ajustan inventario",
        "composite": true,
        "composites": {
          "client": {
            "mto-stock-api": [
              "stock-read",
              "stock-write",
              "stock-delete",
              "stock-adjust"
            ]
          }
        }
      },
      {
        "name": "mto-ops",
        "description": "Explotacion y monitorizacion",
        "composite": true,
        "composites": {
          "client": {
            "mto-stock-api": [
              "stock-read",
              "ops-metrics",
              "ops-write"
            ]
          }
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "mto-stock-api",
      "name": "API de stock MTO",
      "description": "Resource server. No inicia ningun flujo: declara los permisos como roles de cliente y es la audiencia de los tokens.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "mto-frontend",
      "name": "Frontal MTO",
      "description": "Aplicacion de navegador. Authorization Code con PKCE. El grant de acceso directo queda abierto solo en local, para poder pedir un token con curl.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "protocolMappers": [
        {
          "name": "audiencia-mto-stock-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mto-stock-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "almacen.lector",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Lucia",
      "lastName": "Lectora",
      "email": "almacen.lector@mto.local",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "local",
          "temporary": false
        }
      ],
      "realmRoles": [
        "mto-warehouse-viewer"
      ]
    },
    {
      "username": "almacen.operario",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Oscar",
      "lastName": "Operario",
      "email": "almacen.operario@mto.local",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "local",
          "temporary": false
        }
      ],
      "realmRoles": [
        "mto-warehouse-operator"
      ]
    },
    {
      "username": "almacen.responsable",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Rosa",
      "lastName": "Responsable",
      "email": "almacen.responsable@mto.local",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "local",
          "temporary": false
        }
      ],
      "realmRoles": [
        "mto-warehouse-admin"
      ]
    }
  ]
}
