{
  "info": {
    "_postman_id": "0f642f24-06c2-4d98-b364-13b1473f2791",
    "name": "MTO Stock Inventory API",
    "description": "Postman Collection v2.1 for the MTO Stock Inventory API. Requests are organized by module and use environment variables for host, port, API version, and sample resource IDs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response is successful', function () {",
          "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
          "});",
          "pm.test('response is JSON when body is present', function () {",
          "  if (pm.response.text()) {",
          "    pm.response.to.have.header('Content-Type');",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "  }",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://{{host}}:{{port}}/api/{{apiVersion}}/inventory"
    },
    {
      "key": "apiVersion",
      "value": "v1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "The API is an OAuth2 resource server: it validates the tokens Keycloak issues, it does not issue any. Run this request first; the test script stores the access token in the accessToken variable that every other request sends as a bearer. The default user is almacen.operario / local, from the realm that docker-compose imports; almacen.lector and almacen.responsable are the read-only and admin ones. See keycloak/README.md.",
      "item": [
        {
          "name": "Get access token from Keycloak",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"accessToken\", body.access_token);",
                  "pm.test(\"Keycloak returned an access token\", function () {",
                  "    pm.expect(body.access_token).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{keycloakClientId}}"
                },
                {
                  "key": "username",
                  "value": "{{keycloakUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{keycloakPassword}}"
                }
              ]
            },
            "url": "{{keycloakUrl}}/realms/{{keycloakRealm}}/protocol/openid-connect/token",
            "description": "Password grant against Keycloak. The client requesting the token needs an audience mapper adding mto-stock-api to the token 'aud', otherwise this API rejects it."
          }
        }
      ]
    },
